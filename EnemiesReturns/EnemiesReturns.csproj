<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Configurations>Debug;Release;NoWeaver</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="amogus_lovers-StandaloneAncientScepter" Version="1.1.34" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="Moffein-EliteReworks" Version="2.0.0" />
		<PackageReference Include="Moffein-Risky_Artifacts" Version="2.4.21" />
		<PackageReference Include="R2API.DamageType" Version="1.1.7" />
		<PackageReference Include="R2API.Deployable" Version="1.0.1" />
		<PackageReference Include="R2API.Director" Version="3.1.3" />
		<PackageReference Include="R2API.Elites" Version="1.1.1" />
		<PackageReference Include="R2API.Networking" Version="1.0.4" />
		<PackageReference Include="R2API.Orb" Version="1.0.1" />
		<PackageReference Include="R2API.Prefab" Version="1.1.1" />
		<PackageReference Include="R2API.ProcType" Version="1.0.2" />
		<PackageReference Include="R2API.RecalculateStats" Version="1.6.6" />
		<PackageReference Include="R2API.Sound" Version="1.0.3" />
		<PackageReference Include="R2API.TempVisualEffect" Version="1.0.3" />
		<PackageReference Include="RiskOfBrainrot-MoreStats" Version="1.2.7" />
		<PackageReference Include="score-AdvancedPrediction" Version="1.0.4" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
		<PackageReference Include="RoR2BepInExPack" Version="1.48.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Language\en\EnemiesReturns_en.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Language\es-ES\EnemiesReturns_es_ES.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Language\pt-BR\EnemiesReturns_pt.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Language\ru\EnemiesReturns_ru.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="Language\zh-CN\EnemiesReturns_zh-CN.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Behaviors\ContactLight\Providence\" />
	  <Folder Include="libs\" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="call &quot;$(ProjectDir)weave.bat&quot;" />
	</Target>

</Project>
